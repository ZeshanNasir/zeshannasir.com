# =============================================================
# Zeshan Nasir — Canonical Personal Architecture
# =============================================================
zeshannasir.com, www.zeshannasir.com {
	root * /var/www/personal-site
	encode zstd gzip

	@hidden {
		path */.*
		path .*
	}
	respond @hidden 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'none'; frame-ancestors 'none';"
	}

	@resume path /resume.pdf
	header @resume Cache-Control "no-store, max-age=0"
	respond @resume "Not Found" 404

	@html path *.html /
	header @html Cache-Control "no-cache, no-store, must-revalidate"

	@diagrams path /assets/diagrams/*
	header @diagrams Cache-Control "no-cache, no-store, must-revalidate"

	@static {
		path /assets/* /css/* /js/* /favicon.svg
		not path /assets/diagrams/*
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}

	log {
		output file /var/log/caddy/zeshannasir.access.log {
			roll_size 25mb
			roll_keep 3
		}
		format console
	}
}

